# إعدادات بيئة الإنتاج — انسخ إلى prod.env وأكمل القيم الحقيقية.
# ⚠ لا ترفع هذا الملف إلى أي مستودع عام، ولا تضع هذه القيم داخل ملفات اللعبة.
APP_ENV=prod
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+psycopg://legends:CHANGE_ME@postgres:5432/legends
TOKEN_TTL_MINUTES=180
CORS_ORIGINS=https://your-frontend-domain
DEBUG_ECHO_SQL=false
POSTGRES_PASSWORD=CHANGE_ME
