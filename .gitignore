# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/

# Builds: ignore outputs but keep the folder placeholder
Builds/*
!Builds/Android/
Builds/Android/*
!Builds/Android/.gitkeep

# IDE
.vs/
.idea/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db

# Unity crash reports
sysinfo.txt
*.stackdump

# Backend Python
Backend/__pycache__/
Backend/**/__pycache__/
Backend/.venv/
Backend/venv/
Backend/*.db
Backend/.env
Backend/app.log

# Secrets - NEVER commit
*.keystore
!debug.keystore
*.jks
.env

# real env files (only *.env.example are committed)
Deployment/config/*.env
!Deployment/config/*.env.example
